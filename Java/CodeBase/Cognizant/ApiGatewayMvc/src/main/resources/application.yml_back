##server:
  ##port: 8443
  ##ssl:
    ##enabled: true
    ##key-store: classpath:keystore/datascan_localhost.p12
    ##key-store-password: datascan@1234
    ##key-store-type: PKCS12
  ##servlet:
    ##context-path: /gateway

spring:
  
  cloud:
    gateway:
      mvc:
        http-client:
          type: autodetect
          connect-timeout: 60s
          read-timeout: 60s
         
        routes:
          - id: datascan
            uri: http://localhost:7777
            predicates:
            - Path=/XXXXdatascan/**
            - Method=GET,POST,PUT
            filters:
            - StripPrefix=1
            - name: RequestSize
              args:
               maxSize: 5000MB
            metadata:
              cors:
                allowedOrigins: "*"
                allowedMethods: GET,POST,PUT
                allowedHeaders: "*"
                maxAge: 30
                
  threads:
    virtual:
      enabled: true

